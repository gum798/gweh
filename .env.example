# OpenWeatherMap API Key (무료 가입: https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_api_key_here

# NASA API Key (무료: https://api.nasa.gov - DEMO_KEY로 테스트 가능)
VITE_NASA_API_KEY=DEMO_KEY

# Polar Configuration (결제 시스템)
# Product ID는 Polar Dashboard에서 생성한 후 복사
VITE_POLAR_SANDBOX_PRODUCT_ID=your_sandbox_product_id_here
VITE_POLAR_PRODUCT_ID=your_production_product_id_here
# Sandbox 모드: 'true' (테스트), 'false' 또는 제거 (프로덕션)
VITE_POLAR_SANDBOX=true
