# OpenWeatherMap API Key (무료 가입: https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_api_key_here

# NASA API Key (무료: https://api.nasa.gov - DEMO_KEY로 테스트 가능)
VITE_NASA_API_KEY=DEMO_KEY

# Polar Configuration (Server-side - Cloudflare Pages Functions)
# Organization Access Token: Polar Dashboard > Settings > Access Tokens
# 필요 권한: checkouts:write, orders:read, webhooks:read/write
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxx
# Product IDs
POLAR_SANDBOX_PRODUCT_ID=your_sandbox_product_id_here
POLAR_PRODUCT_ID=your_production_product_id_here
# Sandbox 모드: 'true' (테스트), 'false' (프로덕션)
POLAR_SANDBOX=true
